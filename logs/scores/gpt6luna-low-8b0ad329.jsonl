{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-002", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "6/6", "status": "correct", "content": "```python\ndef count_vowel_runs(s: str) -> int:\n    vowels = set(\"aeiou\")\n    count = 0\n    in_run = False\n    for char in s:\n        if char in vowels:\n            if not in_run:\n                count += 1\n                in_run = True\n        else:\n            in_run = False\n    return count\n```", "tests_passed": 6, "tests_total": 6, "note": null}
{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-003", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "5/5", "status": "correct", "content": "```python\ndef merge_slots(slots: list[list[int]]) -> list[list[int]]:\n    if not slots:\n        return []\n    sorted_slots = sorted(slots)\n    merged = [sorted_slots[0][:]]\n    for start, end in sorted_slots[1:]:\n        if start <= merged[-1][1]:\n            merged[-1][1] = max(merged[-1][1], end)\n        else:\n            merged.append([start, end])\n    return merged\n```", "tests_passed": 5, "tests_total": 5, "note": null}
{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-004", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "5/5", "status": "correct", "content": "```python\ndef tally_votes(votes: list[str]) -> list[str]:\n    counts = {}\n    first_seen = {}\n    for index, candidate in enumerate(votes):\n        counts[candidate] = counts.get(candidate, 0) + 1\n        first_seen.setdefault(candidate, index)\n    return sorted(counts, key=lambda candidate: (-counts[candidate], first_seen[candidate]))\n```", "tests_passed": 5, "tests_total": 5, "note": null}
{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-005", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "5/5", "status": "correct", "content": "```python\ndef stair_ways(n: int, broken: list[int]) -> int:\n    mod = 1_000_000_007\n    broken_set = set(broken)\n    ways = [0] * (n + 1)\n    ways[0] = 1\n    for step in range(1, n + 1):\n        if step not in broken_set:\n            ways[step] = (ways[step - 1] + (ways[step - 2] if step >= 2 else 0)) % mod\n    return ways[n]\n```", "tests_passed": 5, "tests_total": 5, "note": null}
{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-006", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "5/5", "status": "correct", "content": "```python\ndef rle_decode(s: str) -> str:\n    result = []\n    count = \"\"\n    for char in s:\n        if char.isdigit():\n            count += char\n        else:\n            result.append(char * (int(count) if count else 1))\n            count = \"\"\n    return \"\".join(result)\n```", "tests_passed": 5, "tests_total": 5, "note": null}
{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-007", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "5/5", "status": "correct", "content": "```python\ndef grid_islands(grid: list[str]) -> list[int]:\n    if not grid:\n        return []\n    rows, cols = len(grid), len(grid[0])\n    visited = set()\n    areas = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != \"#\" or (r, c) in visited:\n                continue\n            stack = [(r, c)]\n            visited.add((r, c))\n            area = 0\n            while stack:\n                cr, cc = stack.pop()\n                area += 1\n                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):\n                    if 0 <= nr < rows and 0 <= nc < cols and grid[nr][nc] == \"#\" and (nr, nc) not in visited:\n                        visited.add((nr, nc))\n                        stack.append((nr, nc))\n            areas.append(area)\n    return sorted(areas, reverse=True)\n```", "tests_passed": 5, "tests_total": 5, "note": null}
{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-008", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "5/5", "status": "correct", "content": "```python\ndef next_bus(times: list[str], now: str) -> str:\n    return min(times, key=lambda time: (time < now, time))\n```", "tests_passed": 5, "tests_total": 5, "note": null}
{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-009", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "6/6", "status": "correct", "content": "```python\ndef bracket_depth(s: str) -> int:\n    opening = \"([{\"\n    closing = \")]}\"\n    pairs = dict(zip(closing, opening))\n    stack = []\n    max_depth = 0\n    for char in s:\n        if char in opening:\n            stack.append(char)\n            max_depth = max(max_depth, len(stack))\n        elif char in closing:\n            if not stack or stack.pop() != pairs[char]:\n                return -1\n    return max_depth if not stack else -1\n```", "tests_passed": 6, "tests_total": 6, "note": null}
{"run_id": "gpt6luna-low-8b0ad329", "model": "gpt-6-luna-low", "question_id": "code-010", "category": "code", "method": "code_tests", "choice_index": 0, "extracted": "6/6", "status": "correct", "content": "```python\ndef split_bill(total: int, weights: list[int]) -> list[int]:\n    weight_sum = sum(weights)\n    shares = [(total * weight) // weight_sum for weight in weights]\n    remainders = [(total * weight) % weight_sum for weight in weights]\n    leftover = total - sum(shares)\n    for index in sorted(range(len(weights)), key=lambda i: (-remainders[i], i))[:leftover]:\n        shares[index] += 1\n    return shares\n```", "tests_passed": 6, "tests_total": 6, "note": null}
